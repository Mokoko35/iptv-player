+    id: `download:${item.title}`,
+    name: item.title,
+    url: fileUrl(item.path ?? ''),
+    logo: item.logo,
+    group: t('İndirilenler'),
+    subtitle: ep ? t('Sezon {season} · Bölüm {episode}', { season: ep.season, episode: ep.episode }) : undefined,
+  }
+}
+
