+        url: prev?.url ?? '',
+        logo: prev?.logo,
+        kind: prev?.kind ?? 'movie',
+        startedAt: prev?.startedAt ?? Date.now(),
+        status: 'active',
+        progress,
+        received: num(msg.received) ?? prev?.received,
+        total: num(msg.total) ?? prev?.total,
+      }))
+      return true
+    }
+    case 'downloadComplete': {
+      const path = text(msg.path)
+      upsert(
+        title,
+        (prev) => ({
+          title,
+          url: prev?.url ?? '',
+          logo: prev?.logo,
+          kind: prev?.kind ?? 'movie',
+          startedAt: prev?.startedAt ?? Date.now(),
+          status: 'done',
+          progress: 100,
+          path,
+          size: num(msg.size) ?? prev?.total,
+          finishedAt: Date.now(),
+          noticeUntil: Date.now() + DONE_NOTICE_MS,
+        }),
+        true,
+      )
+      expireNoticeLater(DONE_NOTICE_MS)
+      return true
+    }
+    case 'downloadError': {
+      upsert(title, (prev) => ({
+        title,
+        url: prev?.url ?? '',
+        logo: prev?.logo,
+        kind: prev?.kind ?? 'movie',
+        startedAt: prev?.startedAt ?? Date.now(),
+        status: 'error',
+        progress: prev?.progress ?? 0,
+        error: text(msg.error) ?? t('Bilinmeyen hata'),
+        finishedAt: Date.now(),
+        noticeUntil: Date.now() + ERROR_NOTICE_MS,
+      }))
+      expireNoticeLater(ERROR_NOTICE_MS)
+      return true
+    }
+    default:
